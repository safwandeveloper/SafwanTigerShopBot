{
  "name": "safwantiger-shop-bot",
  "version": "1.0.0",
  "description": "Futuristic Telegram Shop Bot for @safwantigershopbot — config-driven, Supabase-backed, multi-language.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,json,md}\""
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/conversations": "^2.0.0",
    "@grammyjs/i18n": "^1.1.0",
    "@grammyjs/menu": "^1.3.0",
    "@grammyjs/parse-mode": "^1.11.1",
    "@grammyjs/runner": "^2.0.3",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "grammy": "^1.30.0",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.18.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "resend": "^6.12.2",
    "undici": "^8.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.17.6",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.11.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
