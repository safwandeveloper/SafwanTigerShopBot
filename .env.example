# =====================================================================
# SafwanTiger Shop Bot — Environment Variables
# Copy this file to ".env" and fill in real values. Never commit .env.
# =====================================================================

# --- Telegram ---
# Get from @BotFather after /newbot.
# Either name works; TELEGRAM_BOT_TOKEN is preferred. BOT_TOKEN is accepted as a legacy alias.
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN
# BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN

# Telegram numeric user ID of the primary admin (used to seed the admin table)
ADMIN_USER_ID=8004955979

# Optional: chat that receives every "deep details" log notification
# (top-ups, support sessions, transcripts, PDF sends, language /
# notification toggles, gift redemptions, region changes, balance
# changes, etc.). Orders are routed separately via
# ORDER_LOG_CHAT_ID — see below.
#
# Falls back to ADMIN_USER_ID DM when unset or when the bot can't
# post to the configured chat. The bot must be added as an admin
# with "Post Messages" + "Send Documents" permission for transcript
# PDFs to land.
#
# Accepts either:
#   - @channelusername  for a public channel  (e.g. @safwantigershopsales)
#   - -100<numeric_id>  for a private channel/supergroup  (forward any
#                       message to @userinfobot to read the id).
#   - 0 / off / none / disabled  to opt out (use admin DM only).
LOG_CHAT_ID=@safhubhaijan012826

# Optional: dedicated channel for product-order notifications only
# (the `[ORDER]` event posted by `services/adminLog.logOrderCreated`).
# Same input format as LOG_CHAT_ID. When unset or opted out, orders
# fall back to LOG_CHAT_ID, then to the admin DM.
ORDER_LOG_CHAT_ID=@safbanuunny0138

# Public watcher/feed group for sold, restock and announcement cards.
# Use @username for public groups or the numeric -100... chat id for private groups.
PUBLIC_FEED_CHAT_ID=@TigerStockChat

# Public sales/chat group for simple "Someone just bought..." cards and
# optional broadcast mirrors. For private invite-only groups, add the bot
# to the group and use the numeric -100... chat id here.
PUBLIC_SALES_CHAT_ID=

# Reseller/API-only sales group. For a private invite-only group, use its
# numeric -100... chat id; invite links cannot be used by the Bot API.
# If empty or set to an invite link, API sales fall back to PUBLIC_SALES_CHAT_ID.
API_SALES_CHAT_ID=

# Bot username (without @) — used for referral links
BOT_USERNAME=safwantigershopbot

# --- Supabase ---
# From: Supabase project → Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# IMPORTANT: Use the *service_role* key on the server (never expose it client-side).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...REPLACE_ME

# Optional: anon (public) key — only needed if you build a separate client-side
# admin dashboard against Supabase Auth. The bot itself does NOT use this.
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# --- Bot runtime ---
# "polling" (default, recommended on Railway) or "webhook"
BOT_MODE=polling

# Only used when BOT_MODE=webhook
WEBHOOK_URL=
WEBHOOK_SECRET=
PORT=3000

# Default language for new users (en | ar | vi)
DEFAULT_LANG=en

# Log level (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# --- Optional: Automated Support Assistant ---
# When the admin pastes an API key via the in-bot
# `🤖 AI Setup → 🔑 Set AI API Key` button it's stored in the
# settings table (key `text.ai.api_key`) and takes priority over
# OPENAI_API_KEY below — so this env var is only needed for
# pre-admin-UI deployments.
#
# Provider is auto-detected from the key shape:
#   AIza…  → Google AI Studio (Gemini)   — default model: gemini-2.5-flash
#   sk-…   → OpenAI Chat Completions     — default model: gpt-4o-mini
#
# Leave both empty to use the built-in stub responder.
OPENAI_API_KEY=
# Reused as a generic "preferred model" knob for both providers.
# - For OpenAI keys (`sk-…`): an OpenAI model id (`gpt-4o-mini`,
#   `gpt-4o`, `o3-mini`, …).
# - For Google keys (`AIza…`): a Gemini model id (`gemini-2.5-flash`,
#   `gemini-2.5-flash-lite`, `gemini-2.5-pro`, …). When this var
#   still has its OpenAI default (`gpt-…`) — or any deprecated
#   `gemini-1.5-*` id — the bot transparently substitutes
#   `gemini-2.5-flash` so Google keys work out of the box without
#   env tweaks.
OPENAI_MODEL=gpt-4o-mini

# =====================================================================
# Auto-verify payments
# =====================================================================
# All four providers below are OPTIONAL. The bot starts fine without
# them — auto-verify just falls back to manual admin approval whenever
# the corresponding API key/token is missing.

# --- TonCenter (USDT TON jetton verification)
# https://toncenter.com — free tier works without a key (1 req/sec),
# but adding one buys higher throughput.
TONCENTER_API_KEY=

# --- TronGrid (USDT TRC20 verification)
# https://www.trongrid.io — free tier works without a key, but rate-
# limits aggressively under load.
TRONGRID_API_KEY=

# --- BlockCypher (LTC verification)
# https://www.blockcypher.com — free tier (~3 req/sec) is fine for
# low-volume bots; set this when you start seeing 429 throttles.
BLOCKCYPHER_TOKEN=

# --- CoinGecko (LTC/USD rate quote)
# https://www.coingecko.com — public endpoint works without a key but
# rate-limits to a few requests per minute. Set this on production so
# the LTC quote never fails to fetch when many users open the LTC
# top-up screen at once.
COINGECKO_API_KEY=

# --- Binance Pay (personal-account Spot API auto-verify)
# Generate at https://www.binance.com/en/my/settings/api-management →
# Create API → System generated. Enable ONLY the "Reading" permission;
# leave Spot/Margin Trading, Withdrawals, and Internal Transfer OFF.
#
# When set, the Binance Pay top-up screen polls
# GET /sapi/v1/pay/transactions, matches the user's pasted Order ID
# against your merchant Pay history, and auto-credits on a clean match.
# Leave both blank to keep the admin wizard usable but defer every
# Binance Pay submission to manual admin approval.
#
# Region note: api.binance.com returns HTTP 451 from many cloud
# regions (Azure / Railway). Run the bot through a VPN sidecar to a
# Binance-friendly exit IP. See README → "Binance Pay VPN sidecar".
BINANCE_PAY_API_KEY=
BINANCE_PAY_API_SECRET=
# Optional comma-separated Binance API hosts. Leave blank to use the
# official failover set: api, api-gcp, api1, api2, api3, api4.
BINANCE_API_BASE_URLS=
# Optional proxy URL used ONLY for Binance Pay API calls.
# Example: http://proxy.example.com:8080
BINANCE_PROXY_URL=
# Optional comma-separated failover proxies. The bot tries these first,
# then BINANCE_PROXY_URL, then direct. Use this when one VPN exit starts
# returning HTTP 451.
# Example: http://proxy-nl:8080,http://proxy-fr:8080,http://proxy-de:8080
BINANCE_PROXY_URLS=

# --- Bybit internal-transfer auto-verify
# Users send USDT inside Bybit to your Bybit UID / ID, then paste
# the internal transfer TXID. Requires a Bybit API key with asset /
# wallet read access.
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Optional. Leave blank to use https://api.bybit.com and https://api.bytick.com
BYBIT_API_BASE_URL=
BYBIT_API_BASE_URLS=
# Optional proxy URL used ONLY for Bybit Pay API calls. Use this when
# Bybit/CloudFront blocks Railway's direct country/IP.
# Example: http://proxy-nl:8080
BYBIT_PROXY_URL=
# Optional comma-separated failover proxies. The bot tries these first,
# then BYBIT_PROXY_URL, then the Binance proxy vars if present, then direct.
# Example: http://proxy-nl:8080,http://proxy-fr:8080
BYBIT_PROXY_URLS=

# Telegram Crypto Pay API (USDT wallet top-ups)
CRYPTOBOT_API_TOKEN=
CRYPTOBOT_API_BASE_URL=https://pay.crypt.bot
